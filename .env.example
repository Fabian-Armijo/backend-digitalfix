# ==============================================================================
# DIGITALFIX - CONFIGURACIÓN DE ENTORNO LOCAL / AWS
# Copia este archivo como '.env' en la raíz y reemplaza con tus propios valores
# ==============================================================================

# Dirección del Clúster de RabbitMQ (IP pública o Elástica de tu propia EC2 de RabbitMQ)
# Ejemplo: 44.193.188.103:5672 o si corre localmente en la misma EC2: localhost:5672
RABBITMQ_ADDRESSES=localhost:5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Configuración de Base de Datos PostgreSQL
DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=digitalfix
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword

# Configuración opcional de correo (Mailtrap / Gmail)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=notificaciones@digitalfix.com

# Identificadores de Azure AD / Entra ID (si aplica)
AZURE_TENANT_ID=cac38dd3-e614-48df-967a-3c9e4396eae3
AZURE_CLIENT_ID=e0877608-03e1-4d4b-a0c9-d50d0ddbdb7c
